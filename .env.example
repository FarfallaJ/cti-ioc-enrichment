# Copy this file to ".env" and paste in your own API keys.
# .env is gitignored and will never be committed.

# AlienVault OTX  -> https://otx.alienvault.com/api  (free)
OTX_API_KEY=

# AbuseIPDB       -> https://www.abuseipdb.com/account/api  (free tier)
ABUSEIPDB_API_KEY=

# GreyNoise       -> https://viz.greynoise.io/account/  (free community key)
GREYNOISE_API_KEY=

# Shodan          -> https://account.shodan.io/  (membership / free trial)
SHODAN_API_KEY=

# Copy this file to ".env" and paste in your own API keys.
# .env is gitignored and will never be committed.
#
# Prefer the OS keyring over this file: run  python setup_keys.py  to store keys
# in Windows Credential Manager / macOS Keychain, then you can delete .env.
#
# Keyless sources (crt.sh, RDAP, Shodan InternetDB) need no key and always run.

# --- Tier 1 (highest value) ---
VT_API_KEY=            # VirusTotal   https://www.virustotal.com/gui/join-us
URLSCAN_API_KEY=       # urlscan.io   https://urlscan.io/user/signup
ABUSECH_API_KEY=       # abuse.ch     https://auth.abuse.ch/

# --- Also supported ---
OTX_API_KEY=           # AlienVault OTX   https://otx.alienvault.com/api
ABUSEIPDB_API_KEY=     # AbuseIPDB        https://www.abuseipdb.com/account/api
GREYNOISE_API_KEY=     # GreyNoise        https://viz.greynoise.io/account/
SHODAN_API_KEY=        # Shodan           https://account.shodan.io/
